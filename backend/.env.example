# Nusxa oling: .env  (u git'ga tushmaydi)
ENV=dev

# Ilova 2 xil cheklangan rol bilan ulanadi. Parollarni o'zgartiring, keyin: python -m app.cli setup-roles
DATABASE_URL=postgresql+psycopg://app_api:CHANGE_ME_api@127.0.0.1:5432/chronix
AUTH_DATABASE_URL=postgresql+psycopg://app_auth:CHANGE_ME_auth@127.0.0.1:5432/chronix
# Fon jarayoni (python -m app.worker) — faqat eslatma funksiyalari
WORKER_DATABASE_URL=postgresql+psycopg://app_worker:CHANGE_ME_worker@127.0.0.1:5432/chronix
# Jadvallar egasi — faqat migratsiya va CLI uchun
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/chronix

# Kamida 32 belgi. Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# console — dev (kod javobda qaytadi). eskiz — haqiqiy SMS
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Matnlar Eskiz'da tasdiqlangan shablonlarga aynan mos bo'lishi kerak
SMS_OTP_TEMPLATE=Chronix mobil ilovasiga kirish uchun tasdiqlash kodi: {code}
SMS_RESET_TEMPLATE=Chronix mobil ilovasi parolini tiklash uchun kod: {code}

# Bron eslatmasi (daqiqa): boshlanishidan qancha oldin va javob uchun qancha kutiladi
REMINDER_LEAD_MINUTES=30
REMINDER_RESPONSE_MINUTES=15
CORS_ORIGINS=["http://localhost:5173"]
