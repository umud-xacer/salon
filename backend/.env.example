# Nusxa oling: .env  (u git'ga tushmaydi)
ENV=dev

# Ilova 2 xil cheklangan rol bilan ulanadi. Parollarni o'zgartiring, keyin: python -m app.cli setup-roles
DATABASE_URL=postgresql+psycopg://app_api:CHANGE_ME_api@127.0.0.1:5432/salon_platform
AUTH_DATABASE_URL=postgresql+psycopg://app_auth:CHANGE_ME_auth@127.0.0.1:5432/salon_platform
# Jadvallar egasi — faqat migratsiya va CLI uchun
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/salon_platform

# Kamida 32 belgi. Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

SMS_PROVIDER=console
CORS_ORIGINS=["http://localhost:5173"]
