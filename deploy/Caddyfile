{$API_DOMAIN} {$API_ALIAS:} {
	encode gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Yuklangan rasmlar: faqat fayl beriladi, katalog ro'yxati yo'q
	handle_path /media/* {
		root * /srv/media
		header {
			X-Content-Type-Options nosniff
			Cache-Control "public, max-age=31536000, immutable"
		}
		file_server
	}

	handle {
		reverse_proxy api:8000
	}
}

# Veb-panel: API shu domen ostida, shuning uchun CORS kerak emas.
# Bitta panel ikki domenda: kim qayerda kira olishini API Host bo'yicha hal qiladi (app/core/panels.py)
(web_panel) {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# OpenStreetMap xarita rasmlari Referer'siz bloklanadi; tashqariga faqat domen ketadi
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Kamera — ombor shtrix-kod skaneri uchun (faqat o'z sahifamiz); qolganlari yopiq
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web
		# Nomi xeshlangan fayllar uzoq keshlanadi, index.html esa yo'q: yangi versiya darhol ko'rinsin
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# chronix.uz — mijozlar platformasi (market/; /biznes ham shu ilova ichida), API shu domen ostida (/api, CORS kerak emas).
# Kompyuterdan: sh deploy/publish-market.sh
{$LANDING_DOMAIN} {$LANDING_ALIAS:} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Geolokatsiya — "Mening joylashuvim" (faqat o'z sahifamiz); Google bilan kirish oynasi uchun popup ruxsat
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin-allow-popups
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Qidiruv tizimlari uchun (app/api/v1/seo.py): sitemap — barcha salonlar ikki tilda; sahifalar — sarlavha,
	# tavsif, hreflang, JSON-LD va asosiy matn bilan tayyor HTML. API ishlamasa — pastdagi handle_errors oddiy faylni beradi.
	handle /sitemap.xml {
		rewrite * /api/v1/seo/sitemap.xml
		reverse_proxy api:8000
	}
	@seo path / /ru /ru/ /qidiruv /ru/qidiruv /biznes /ru/biznes /s/* /ru/s/*
	handle @seo {
		rewrite * /api/v1/seo/render?path={path}
		reverse_proxy api:8000 {
			@fail status 5xx
			handle_response @fail {
				root * /srv/market
				rewrite * /index.html
				file_server
			}
		}
	}

	# Yo'q fayl (kengaytmali: .json, .txt, .xml ...) — 404, SPA sahifasi emas (masalan /ai-catalog.json).
	# Alohida handle: bitta blok ichida try_files respond'dan oldin ishlaydi va yo'lni /index.html ga almashtiradi
	@missingfile {
		path_regexp \.[A-Za-z0-9]{1,8}$
		not file {
			root /srv/market
		}
	}
	handle @missingfile {
		respond 404
	}

	handle {
		root * /srv/market
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		# /privacy, /hisobni-ochirish — statik sahifalar (market/public/<nom>/index.html); qolgani — SPA
		try_files {path} {path}/index.html /index.html
		file_server
	}

	# API'ga ulanib bo'lmasa (qayta ishga tushish paytida): sitemap — statik fayl, sahifalar — oddiy SPA
	handle_errors 502 503 504 {
		root * /srv/market
		@sitemap path /sitemap.xml
		rewrite @sitemap /sitemap.xml
		@page not path /sitemap.xml /api/*
		rewrite @page /index.html
		file_server
	}
}

# Salon rahbarlari va xodimlari (www.chronix.uz; WEB_ALIAS — qo'shimcha manzil, masalan admin.chronix.uz)
{$WEB_DOMAIN} {$WEB_ALIAS:} {
	import web_panel
}

# Faqat Super Admin
{$ADMIN_DOMAIN} {$ADMIN_ALIAS:} {
	import web_panel
}

# Shu serverdagi boshqa loyihalar (git'da yo'q): deploy/sites/*.caddy
import /etc/caddy/sites/*.caddy
