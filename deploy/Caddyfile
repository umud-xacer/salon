{$API_DOMAIN} {$API_ALIAS:} {
	encode gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Yuklangan rasmlar: faqat fayl beriladi, katalog ro'yxati yo'q
	handle_path /media/* {
		root * /srv/media
		header {
			X-Content-Type-Options nosniff
			Cache-Control "public, max-age=31536000, immutable"
		}
		file_server
	}

	handle {
		reverse_proxy api:8000
	}
}

# Veb-panel: API shu domen ostida, shuning uchun CORS kerak emas.
# Bitta panel ikki domenda: kim qayerda kira olishini API Host bo'yicha hal qiladi (app/core/panels.py)
(web_panel) {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# OpenStreetMap xarita rasmlari Referer'siz bloklanadi; tashqariga faqat domen ketadi
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Kamera — ombor shtrix-kod skaneri uchun (faqat o'z sahifamiz); qolganlari yopiq
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web
		# Nomi xeshlangan fayllar uzoq keshlanadi, index.html esa yo'q: yangi versiya darhol ko'rinsin
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# chronix.uz — mijozlar platformasi (market/), API shu domen ostida (/api, CORS kerak emas),
# taqdimot sayti (landing/) — /biznes/. Kompyuterdan: sh deploy/publish-market.sh, sh deploy/publish-landing.sh
{$LANDING_DOMAIN} {$LANDING_ALIAS:} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Geolokatsiya — "Mening joylashuvim" (faqat o'z sahifamiz); Google bilan kirish oynasi uchun popup ruxsat
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin-allow-popups
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	redir /biznes /biznes/ 308
	handle_path /biznes/* {
		root * /srv/landing
		@lassets path /assets/*
		header @lassets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/market
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		# /privacy, /hisobni-ochirish — statik sahifalar (market/public/<nom>/index.html); qolgani — SPA
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

# Salon rahbarlari va xodimlari (www.chronix.uz; WEB_ALIAS — o'tish davrida eski manzillar, masalan www.ariqalqon.uz)
{$WEB_DOMAIN} {$WEB_ALIAS:} {
	import web_panel
}

# Faqat Super Admin
{$ADMIN_DOMAIN} {$ADMIN_ALIAS:} {
	import web_panel
}

# Shu serverdagi boshqa loyihalar (git'da yo'q): deploy/sites/*.caddy
import /etc/caddy/sites/*.caddy
