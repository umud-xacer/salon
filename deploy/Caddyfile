{$API_DOMAIN} {$API_ALIAS:} {
	encode gzip

	# Yuklangan rasmlar: faqat fayl beriladi, katalog ro'yxati yo'q
	handle_path /media/* {
		root * /srv/media
		header {
			X-Content-Type-Options nosniff
			Cache-Control "public, max-age=31536000, immutable"
		}
		file_server
	}

	handle {
		reverse_proxy api:8000
	}
}

# Veb-panel: API shu domen ostida, shuning uchun CORS kerak emas.
# Bitta panel ikki domenda: kim qayerda kira olishini API Host bo'yicha hal qiladi (app/core/panels.py)
(web_panel) {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# OpenStreetMap xarita rasmlari Referer'siz bloklanadi; tashqariga faqat domen ketadi
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000"
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web
		# Nomi xeshlangan fayllar uzoq keshlanadi, index.html esa yo'q: yangi versiya darhol ko'rinsin
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Salon rahbarlari va xodimlari
{$WEB_DOMAIN} www.{$WEB_DOMAIN} {
	import web_panel
}

# Faqat Super Admin
{$ADMIN_DOMAIN} {$ADMIN_ALIAS:} {
	import web_panel
}

# Shu serverdagi boshqa loyihalar (git'da yo'q): deploy/sites/*.caddy
import /etc/caddy/sites/*.caddy
