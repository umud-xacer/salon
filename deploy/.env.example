# setup.sh shu fayldan .env yaratadi va parollarni o'zi to'ldiradi. .env git'ga tushmaydi.
ENV=prod

# Masalan api.chronix.uz yoki domen bo'lmasa 1.2.3.4.sslip.io
API_DOMAIN=
# Veb-panel domeni, www avtomatik qo'shiladi. Masalan chronix.uz
WEB_DOMAIN=
# Super Admin paneli alohida domenda (DNS A-yozuvi kerak)
ADMIN_DOMAIN=
ADMIN_ALIAS=
# Panellarni ajratish: DNS va sertifikat tayyor bo'lgach yoqiladi (bo'sh — cheklov yo'q)
# ADMIN_PANEL_HOSTS=["ega.ariqalqon.uz","www.ega.ariqalqon.uz"]
# BUSINESS_PANEL_HOSTS=["ariqalqon.uz","www.ariqalqon.uz"]
PUBLIC_BASE_URL=https://__API_DOMAIN__
CORS_ORIGINS=["https://__API_DOMAIN__"]

POSTGRES_PASSWORD=__POSTGRES__
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:__POSTGRES__@db:5432/chronix
DATABASE_URL=postgresql+psycopg://app_api:__API__@db:5432/chronix
AUTH_DATABASE_URL=postgresql+psycopg://app_auth:__AUTH__@db:5432/chronix
WORKER_DATABASE_URL=postgresql+psycopg://app_worker:__WORKER__@db:5432/chronix
JWT_SECRET=__JWT__

# Prod'da majburiy. Shablonlar Eskiz'da tasdiqlanmaguncha OTP SMS yetib bormaydi
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=__ESKIZ_EMAIL__
ESKIZ_PASSWORD=__ESKIZ_PASSWORD__
ESKIZ_FROM=4546

YANDEX_GEOCODER_API_KEY=
# Mijoz ilovasidagi xarita (Yandex JS API). Bo'sh — OpenStreetMap. Kabinetda Referer: ariqalqon.uz
YANDEX_MAPS_JS_KEY=
